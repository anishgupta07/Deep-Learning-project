# Byte-compiled / optimized / packaging artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
.venv/
env/
venv/

# Large intermediate genomics sequencing data and alignments
*.bam
*.bai
*.sam
*.mmi.tmp

# Raw SRA FASTA/FASTQ downloads
SRR*.fasta
SRR*.fastq
SRR*.fastq.gz
class_*/*.fasta
class_*/*.fastq
class_*/*.fastq.gz

# VCF and large genomic archives (>100MB cannot be pushed to standard GitHub)
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.tbi
*.txt.gz
raw_data/
data/raw/
data/patient_vcf_test/
variant_summary.txt.gz
HG002*.vcf.gz
!reference.vcf
!*reference*.vcf
!data/demo/sample_demo.vcf
!sample_demo.vcf

# Local archived large data (>100MB cannot be pushed to standard GitHub)
archive/data/*.gz
archive/data/*.vcf.gz
archive/data/*.txt.gz

# Cache files
reports/**/fontlist*.json
reports/fontlist*.json
.pytest_cache/

# Large binary embeddings (>100MB cannot be pushed to standard GitHub)
data/**/*.pt
data/*.pt
data/cache/esm_embeddings.pt

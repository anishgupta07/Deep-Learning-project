# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
env/
venv/

# Large intermediate genomics sequencing data and alignments
*.bam
*.bai
*.sam
*.mmi.tmp

# Raw SRA FASTA/FASTQ downloads (pipeline streams and deletes these)
SRR*.fasta
SRR*.fastq
SRR*.fastq.gz
class_*/*.fasta
class_*/*.fastq
class_*/*.fastq.gz

# VCF and large genomic archives (>100MB cannot be pushed to standard GitHub)
*.vcf
*.vcf.gz
*.txt.gz
raw_data/
variant_summary.txt.gz
HG002*.vcf.gz
!reference.vcf
!*reference*.vcf

# Local archived files (>100MB cannot be pushed to standard GitHub)
others/data/*.gz
others/data/*.vcf.gz
others/data/*.txt.gz

# Cache files
reports/fontlist*.json
.pytest_cache/

# Large binary embeddings (>100MB cannot be pushed to standard GitHub)
data/*.pt
data/esm_embeddings.pt

